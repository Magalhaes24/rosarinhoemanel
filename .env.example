# Copia para .env e preenche. O .env NÃO vai para o git.
#
# Os valores reais estão na consola do Firebase, em
# Definições do projeto > Os seus apps > Configuração do SDK.
#
# Nota: estes valores acabam dentro do JavaScript que o browser descarrega —
# são públicos por natureza. Não são segredos; estão aqui para ser fácil
# apontar o site para outro projeto Firebase. Ainda assim ficam por preencher,
# porque um ficheiro de exemplo deve mostrar o formato, não os dados.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=nome-do-projeto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=nome-do-projeto
VITE_FIREBASE_STORAGE_BUCKET=nome-do-projeto.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# UID da única conta de administração.
# Firebase Console > Authentication > Users > copiar o "User UID".
# Tem de ser o MESMO valor que está em firestore.rules (é lá que conta a sério).
VITE_ADMIN_UID=

# Chave de site do reCAPTCHA v3, usada pelo App Check.
# Cria em: Firebase Console > App Check > Apps > Web > reCAPTCHA v3
# Sem isto o site funciona, mas fica sem App Check.
VITE_RECAPTCHA_SITE_KEY=
