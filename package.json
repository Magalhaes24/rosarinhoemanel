  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:regras": "firebase emulators:exec --only firestore --project regras-teste \"node --test tests/regras.test.js\"",
