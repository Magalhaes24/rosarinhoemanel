rules_version = '2';

// Modelo de segurança.
//
// Convidados (sem sessão): criam uma resposta e leem o conteúdo público do
// site (textos, tema, lista de presentes). Nada mais.
//
// Administração: exatamente UMA conta, identificada pelo UID abaixo. É a única
// que lê as respostas e a única que escreve conteúdo.
//
// O volume de escrita abusiva é travado pelo App Check (src/lib/firebase.js).

service cloud.firestore {
  match /databases/{database}/documents {

    // UID da única conta de administração.
    // Tem de ser igual ao de storage.rules e ao da variável VITE_ADMIN_UID.
    // Não é um segredo: identifica uma conta, não dá acesso a ela.
    function adminUid() {
      return 'bzMecKwuhHNovXKZme0OFmqQ1UF3';
    }

    function ehAdmin() {
      return request.auth != null
        && request.auth.uid == adminUid();
    }

    // Texto não vazio, dentro de um limite, e que não seja só espaços.
    function textoValido(v, maxLen) {
      return v is string
        && v.size() <= maxLen
        && v.trim().size() > 0;
    }

    function textoOpcional(v, maxLen) {
      return v is string && v.size() <= maxLen;
    }

    // A data tem de ser a do servidor: impede datas forjadas pelo cliente.
    function dataDoServidor() {
      return request.resource.data.criadoEm == request.time;
    }

    // ---------------------------------------------------------------------
    // Respostas dos convidados
    // ---------------------------------------------------------------------

    match /rsvps/{doc} {
      allow read, update, delete: if ehAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(['nome', 'presenca', 'criadoEm']) &&
        request.resource.data.keys().hasAll(['nome', 'presenca', 'criadoEm']) &&
        textoValido(request.resource.data.nome, 120) &&
        request.resource.data.presenca in ['sim', 'nao'] &&
        dataDoServidor();
    }

    match /presentes/{doc} {
      allow read, update, delete: if ehAdmin();
      allow create: if
        request.resource.data.keys().hasOnly(['nome', 'presente', 'mensagem', 'criadoEm']) &&
        request.resource.data.keys().hasAll(['nome', 'presente', 'mensagem', 'criadoEm']) &&
        textoValido(request.resource.data.nome, 120) &&
        textoValido(request.resource.data.presente, 200) &&
        textoOpcional(request.resource.data.mensagem, 1000) &&
        dataDoServidor();
    }

    // ---------------------------------------------------------------------
    // Conteúdo do site — textos, tema, secções.
    //
    // Leitura pública: é o que o site mostra a toda a gente. Escrita só do
    // admin. O limite de 400 kB evita que um erro ou um abuso encha o
    // documento; o conteúdo real anda pelos poucos kB.
    // ---------------------------------------------------------------------

    match /conteudo/{doc} {
      allow read: if true;
      allow write: if ehAdmin()
        && request.resource.data.size() < 400000;
    }

    // ---------------------------------------------------------------------
    // Lista de presentes "Para a casa" — gerida pelo admin, vista por todos.
    // ---------------------------------------------------------------------

    match /presentes-casa/{doc} {
      allow read: if true;
      allow create, update: if ehAdmin()
        && textoValido(request.resource.data.nome, 160)
        && textoOpcional(request.resource.data.get('descricao', ''), 1000)
        && textoOpcional(request.resource.data.get('imagem', ''), 600)
        && textoOpcional(request.resource.data.get('link', ''), 600);
      allow delete: if ehAdmin();
    }

    // ---------------------------------------------------------------------
    // Fotografias em base64.
    //
    // O Firebase Storage exige o plano Blaze, por isso as fotografias que a
    // administração carrega ficam aqui, uma por documento. São públicas
    // porque é o que o site mostra; só o admin as cria e apaga.
    //
    // O limite de 750 kB é a rede de segurança do lado do servidor: o browser
    // já reduz e recomprime antes de enviar (src/lib/fotografias.js), mas sem
    // isto uma imagem grande passaria e rebentaria o limite de 1 MiB por
    // documento do próprio Firestore.
    // ---------------------------------------------------------------------

    match /fotografias/{doc} {
      allow read: if true;
      allow create: if ehAdmin()
        && request.resource.data.keys().hasOnly(['dados', 'largura', 'altura', 'criadoEm'])
        && request.resource.data.dados is string
        && request.resource.data.dados.size() < 750000
        && request.resource.data.dados.matches('data:image/.*')
        && dataDoServidor();
      allow update: if false;
      allow delete: if ehAdmin();
    }

    // Tudo o resto fechado, para toda a gente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
